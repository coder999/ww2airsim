 "badge": {
  "id": "operation-te-go",
  "name": "Operation Te-Go"
 },
 "briefing": {
  "situation": "ALTERNATE HISTORY. Dawn, 7 December 1944, the morning after the paratroop drop on Burauen went right. You are a Japanese fighter pilot on the ramp at Buri. Stay with the Ki-21 bombers until two of them have released over Tacloban, see the Ki-57 transports through their drop on San Pablo, and break up the American P-38 response. Buri and Bayug then pass to Japanese control: hold them until the American reinforcements arrive, and land at Buri or Bayug.",
  "loadout": "clean"
 },
 "history": {
  "text": "Operation Te-Go was a real Japanese attempt on 6 and 7 December 1944 to seize the Burauen airfields with paratroops and bombing, and it failed: the transports were shot down or scattered, and the American garrison held. THIS SORTIE IS ALTERNATE HISTORY, not a reconstruction: it asks what would have followed if the Te-Go drop and its air support had worked, and its outcome never happened. The air and ground action of both days is compressed into one dawn, the Ki-57 stands in for the transport force (the source does not name every aircraft), and the Type B Marus stand in for American transports.",
  "sources": [
   "M. Hamlin Cannon, Leyte: The Return to the Philippines (Washington: Office of the Chief of Military History, 1954; CMH Pub 5-9-1), ch. XVII, U.S. Army Center of Military History: https://www.ibiblio.org/hyperwar/USA/USA-P-Return/USA-P-Return-17.html",
   "United States Strategic Bombing Survey, The Fifth Air Force in the War Against Japan (1947): https://www.ibiblio.org/hyperwar/NHC/NewPDFs/USAAF/United%20States%20Strategic%20Bombing%20Survey/USSBS%20Fifth%20Air%20Force%20in%20the%20War%20Against%20Japan.pdf"
  ]
 }
}
