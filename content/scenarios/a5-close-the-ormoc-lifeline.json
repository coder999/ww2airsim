  "badge": {
    "id": "close-the-ormoc-lifeline",
    "name": "Close the Ormoc Lifeline"
  },
  "briefing": {
    "situation": "Close the Ormoc Lifeline (11 November, mid-morning, broken cloud). You and one wingman escort four Avengers west toward Ormoc Bay, where a convoy of three transports with two destroyer escorts is steaming for the pier. Hold station on the Avengers and keep the fighters off them: they carry the torpedoes. At least three must release, at least three must reach the rally point east of the bay, and at most one may be lost. Then land at any friendly base; the Essex is the suggested recovery. Beating down one of the escorts after the torpedoes are away is the bonus. This is a composite and a compression: the real 11 November strike was far larger, and this package of six aircraft against six ships does not claim to be a formation that flew.",
    "loadout": "both"
  },
  "history": {
    "text": "On 11 November 1944 fast-carrier aircraft struck a Japanese reinforcement convoy in Ormoc Bay and destroyed four transports and most of its escorts. This mission is a composite inspired by that strike, and is not a reconstruction of any one formation: the force here is far smaller, the Avengers are four, and the counts of ships and fighters are chosen for play.",
    "sources": [
      "Office of the Chief of Naval Operations, The United States Navy at War, 1941-1945 (second report), 1946: https://www.ibiblio.org/hyperwar/USN/USNatWar/USN-King-2.html",
      "Official U.S. Navy Chronology of the Second World War, 11 November 1944: https://www.ibiblio.org/hyperwar/USN/USN-Chron/USN-Chron-1944.html",
      "Army Air Forces, The Pacific: Guadalcanal to Saipan, ch. XII (Leyte air campaign): https://www.ibiblio.org/hyperwar/AAF/V/AAF-V-12.html"
    ]
  }
}
