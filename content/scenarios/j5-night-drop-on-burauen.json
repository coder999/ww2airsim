 "badge": {
  "id": "night-drop-on-burauen",
  "name": "Night Drop on Burauen"
 },
 "briefing": {
  "situation": "Burauen, 6 December 1944, 1830, the light going. You lead two more Ki-57 transports east over the ridge from the Ormoc side with a Ki-43 and a Zero as escort. Hold the drop corridor on the signal fires at San Pablo, open the cargo doors (O) and drop your stick (Y): six squad rigs and two supply bundles from each transport. At least one other transport must drop too. Four P-38s are up. There is no field to land at: crossing the western gate is the recovery.",
  "loadout": "clean"
 },
 "history": {
  "text": "On 6 December 1944 Japanese transports dropped paratroops on the Burauen airfields as part of Operation Te-Go (Army, Leyte, ch. XVII). This mission is inspired by that drop, not a reconstruction of it: the Ki-57 is representative of the transports, the formation, the escort, the four P-38s and the time are invented for the game, and each rig stands for a squad, not an individual man.",
  "sources": [
   "U.S. Army, Leyte: The Return to the Philippines, ch. XVII (1954), https://www.ibiblio.org/hyperwar/USA/USA-P-Return/USA-P-Return-17.html",
   "U.S. Army, Leyte: The Return to the Philippines, ch. VIII (1954), https://www.ibiblio.org/hyperwar/USA/USA-P-Return/USA-P-Return-8.html"
  ]
 }
