{
  "name": "ww2airsim",
  "version": "1.0.0",
  "description": "A WWII Pacific air combat simulator that runs in the browser. Fly an F6F Hellcat from carrier and land bases over a geographically real Leyte Gulf, fight, and get back aboard — because your score does not count until you do.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools spike --max-warnings 0",
    "dev": "vite",
    "dev:lan": "WW2AIRSIM_TUNNEL=1 vite",
    "build": "vite build",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm test",
    "golden:regen": "tsx tools/golden/generate.ts",
    "bathy:build": "tsx tools/bathy/build.ts",
    "terrain:build": "tsx tools/terrain/build.ts",
    "landcover:build": "tsx tools/landcover/build.ts",
    "sky:build": "tsx tools/sky/build.ts",
    "models:build": "tsx tools/models/build.ts",
    "audio:rocket-whoosh": "tsx tools/audio/synthesizeRocketWhoosh.ts",
    "spike:webgpu": "vite --config spike/webgpu-day0/vite.config.ts",
    "test:tier2": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "three": "^0.186.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.72",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "geotiff": "^3.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
